{
  "name": "wedding",
  "scripts": {
    "build": "gatsby clean && gatsby build",
    "upload": "rsync -r -e ssh public/* john@apps.j0.hn:/apps/victoria-and/wedding",
    "develop": "gatsby develop",
    "format": "prettier {src/*,src/**/*} --write",
    "start": "yarn develop",
